---
interface Props {
  photos: string[];
}
const { photos } = Astro.props as Props;
const columns = [photos.slice(0, 3), photos.slice(3, 6), photos.slice(6, 9)];
---

<section
  data-surface="dark"
  class="relative z-10 overflow-hidden py-24 sm:py-32"
  aria-labelledby="gallery-heading"
>
  <div class="shell">
    <div class="max-w-2xl">
      <p class="eyebrow reveal text-ember-400">The space</p>
      <h2
        id="gallery-heading"
        class="display-xl reveal mt-6 text-[clamp(2rem,5vw,3.6rem)] text-bone-100"
      >
        <span class="line-mask"><span class="reveal-line">Low light,</span></span>
        <span class="line-mask"><span class="reveal-line">long evenings.</span></span>
      </h2>
      <p class="reveal mt-6 text-[0.98rem] leading-relaxed text-bone-200/60">
        Amber pools of light, worn stone, and tables that stay occupied well past midnight.
        Photographed on Erbil Avenue.
      </p>
    </div>

    <div class="reveal mt-14 grid grid-cols-2 gap-3 sm:grid-cols-3 sm:gap-4">
      {
        columns.map((col, ci) => (
          <div class="flex flex-col gap-3 sm:gap-4">
            {col.map((src, ri) => (
              <figure
                class:list={[
                  'media group relative overflow-hidden rounded-2xl sm:rounded-3xl',
                  (ci + ri) % 3 === 0 ? 'aspect-[4/5]' : 'aspect-square',
                ]}
                data-tilt
                data-intensity="5"
              >
                <img
                  src={src}
                  alt={`Dune café ambience, Erbil Avenue — photo ${ci * 3 + ri + 1}`}
                  loading="lazy"
                  decoding="async"
                  referrerpolicy="no-referrer"
                  data-loaded="false"
                  class="group-hover:scale-[1.05]"
                />
                <span
                  class="pointer-events-none absolute inset-0 bg-ember-400/0 transition-colors duration-700 group-hover:bg-ember-400/10"
                  aria-hidden="true"
                />
              </figure>
            ))}
          </div>
        ))
      }
    </div>
  </div>
</section>