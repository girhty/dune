---
interface Props {
  rating: number;
  followers: number;
}
const { rating, followers } = Astro.props as Props;

const quotes = [
  { text: 'No rules. Just vibes.', meta: 'Captured in the room' },
  { text: 'Every detail was made to create an unforgettable experience.', meta: 'On the build' },
  { text: 'From the desert to the mountains.', meta: 'The Dune idea' },
];
---

<section
  id="reviews"
  data-surface="dark"
  class="relative z-10 overflow-hidden pb-24 pt-8 sm:pb-32"
  aria-labelledby="reviews-heading"
>
  <div class="shell">
    <h2 id="reviews-heading" class="sr-only">Rating and community</h2>

    <div class="grid gap-6 lg:grid-cols-12">
      <!-- Google rating card -->
      <div
        class="reveal relative overflow-hidden rounded-3xl border border-bone-100/12 bg-void-800/60 p-8 backdrop-blur-md sm:rounded-4xl sm:p-10 lg:col-span-5"
      >
        <p class="eyebrow text-bone-200/45">Google reviews</p>
        <div class="mt-6 flex items-end gap-4">
          <span class="display-xl text-[clamp(3.6rem,10vw,6rem)] leading-none text-bone-100">
            <span class="counter" data-value={rating} data-decimals="1">{rating.toFixed(1)}</span>
          </span>
          <span class="pb-2">
            <span class="block text-xl text-ember-400" aria-hidden="true">★★★★★</span>
            <span class="eyebrow mt-2 block text-bone-200/45" style="font-size:0.56rem"
              >Out of 5.0</span
            >
          </span>
        </div>
        <p class="mt-7 max-w-sm text-[0.9rem] leading-relaxed text-bone-200/55">
          Newly listed on Google and building its review base — the room speaks for itself
          every night on Erbil Avenue.
        </p>
        <a
          href="https://www.google.com/maps/search/?api=1&query=Dune+Erbil+Eribl+Governorate"
          target="_blank"
          rel="noopener noreferrer"
          class="link-underline mt-8 inline-block text-[0.82rem] font-medium text-ember-300"
        >
          Leave a review on Google
        </a>
      </div>

      <!-- Instagram community card -->
      <div
        class="reveal relative overflow-hidden rounded-3xl border border-bone-100/12 bg-void-800/60 p-8 backdrop-blur-md sm:rounded-4xl sm:p-10 lg:col-span-3"
      >
        <p class="eyebrow text-bone-200/45">On Instagram</p>
        <p class="display-xl mt-6 text-[clamp(2.6rem,7vw,4.4rem)] leading-none text-bone-100">
          <span class="counter" data-value={followers} data-decimals="0">{followers.toLocaleString('en-US')}</span>
        </p>
        <p class="eyebrow mt-4 text-ember-300" style="font-size:0.56rem">Followers</p>
        <p class="mt-7 text-[0.9rem] leading-relaxed text-bone-200/55">
          A community that shows up for breakfast, stays for the kitchen, and photographs
          everything in between.
        </p>
      </div>

      <!-- Community voices -->
      <div class="grid gap-6 lg:col-span-4">
        {
          quotes.map((q) => (
            <blockquote
              class="reveal relative rounded-3xl border border-bone-100/10 bg-void-800/40 p-6 backdrop-blur-sm"
            >
              <span class="text-2xl leading-none text-ember-400/60" aria-hidden="true">“</span>
              <p class="mt-3 font-display text-[1.02rem] leading-snug text-bone-100">{q.text}</p>
              <footer class="eyebrow mt-4 text-bone-200/40" style="font-size:0.54rem">
                — {q.meta}
              </footer>
            </blockquote>
          ))
        }
      </div>
    </div>
  </div>
</section>